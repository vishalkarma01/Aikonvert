<div id="account-modal" class="upload-overlay" style="display:none;">
  <div class="upload-container">

    <!-- Dynamic Title -->
    <h2 id="account-modal-title">Create Your Account</h2>

    <p id="account-subtext">Get 10 free coupons to use our converter services.</p>

    <div id="account-info"></div>

    <form id="create-account-form">
      <input type="text" id="nickname" name="nickname" placeholder="Nickname" required class="file-input">
      <input type="email" id="email" name="email" placeholder="Email" required class="file-input">
      <button type="submit" class="upload-btn">Create Account</button>
    </form>

  </div>
</div>
